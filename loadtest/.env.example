# Shared by both loadtest/wsload and loadtest/k6/api_load.js. wsload derives
# its ws(s)://.../ws target from BASE_URL automatically; set WSLOAD_URL
# instead if that derivation doesn't fit (custom path, different host, etc).
BASE_URL=http://127.0.0.1:8081
# WSLOAD_URL=wss://your-app.up.railway.app/ws

# k6 (loadtest/k6/api_load.js) only — scenario sizing. Vehicle IDs are
# fetched live from GET /vehicles at test start, not assumed from a range.
BATCH_SIZE=200
BATCH_RATE=10
READ_RATE=20
CHURN_VUS=5
DURATION=2m

# k6 pass/fail thresholds. Defaults assume localhost-level latency — raise
# these when pointing BASE_URL at a live remote deployment, or a healthy
# environment can false-fail on network RTT alone.
P95_WRITE_MS=500
P95_READ_MS=300
MAX_FAIL_RATE=0.01
